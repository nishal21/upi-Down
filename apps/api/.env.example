PORT=3020
HOST=127.0.0.1
DATABASE_URL=postgres://upidown:change-me@127.0.0.1:5442/upidown
REDIS_URL=redis://127.0.0.1:6390
# Long random string; rotates the device-hash salt daily together with the date.
HASH_SECRET=change-me
# Comma-separated origins allowed to call the API (web + Capacitor app).
CORS_ORIGINS=http://localhost:3000,https://app.upidown.nishal.dev
MAX_SSE=2000
# Optional. When set, reports need a Turnstile token during traffic spikes.
# Local dev with Cloudflare's always-pass test pair: secret 1x0000000000000000000000000000000AA,
# which reports hostname example.com.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,example.com
SPIKE_PER_MINUTE=600
